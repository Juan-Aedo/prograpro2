generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  supabaseId   String?   @unique
  nombre       String
  email        String    @unique
  passwordHash String
  avatar       String    @default("U")
  preferencias String[]  @default([])
  edad         Int?
  sexo         String?
  ciudad       String?
  lat          Float?
  lng          Float?
  telefono     String?
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Activity {
  id              String    @id @default(cuid())
  nombre          String
  descripcion     String
  categoria       String
  imagen          String
  direccion       String
  lat             Float
  lng             Float
  apertura        String
  cierre          String
  diasDisponibles String[]
  moneda          String    @default("CLP")
  valor           Int
  esPorPersona    Boolean   @default(true)
  rating          Float     @default(0)
  totalResenas    Int       @default(0)
  afluencia       String    @default("media")
  tags            String[]
  destacada       Boolean   @default(false)
  enTendencia     Boolean   @default(false)
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoria])
  @@index([destacada])
  @@index([enTendencia])
}

model Booking {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fecha      String
  hora       String
  personas   Int
  estado     String   @default("pendiente")
  total      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([activityId])
}
